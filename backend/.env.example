# Production/local backend environment
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=<generate-a-random-secret-at-least-32-characters>
# 64-character hexadecimal key for AES-256-GCM encryption of sensitive HR details
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HR_DATA_ENCRYPTION_KEY=<64-hex-characters>
CLIENT_URL=http://localhost:3001

# Google Gmail + Calendar OAuth (Admin/HR integration)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:5000/api/integrations/google/gmail/callback

# Base64-encoded 32-byte key used to encrypt stored Google OAuth tokens
GOOGLE_TOKEN_ENCRYPTION_KEY=
